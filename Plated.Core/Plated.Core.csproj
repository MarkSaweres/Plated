<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Plated.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.80" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />

    <!-- Firebase (Auth, Firestore, Storage) -->
    <PackageReference Include="Plugin.Firebase.Core" Version="4.2.0" />
    <PackageReference Include="Plugin.Firebase.Auth" Version="5.0.1" />
    <PackageReference Include="Plugin.Firebase.Auth.Google" Version="3.1.2" />
    <PackageReference Include="Plugin.Firebase.Firestore" Version="4.0.0" />
    <PackageReference Include="Plugin.Firebase.Storage" Version="4.0.0" />

    <!-- On-device OCR for reading plates from photos -->
    <PackageReference Include="Plugin.Maui.OCR" Version="1.1.1" />
  </ItemGroup>

</Project>
