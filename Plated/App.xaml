<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Plated"
             xmlns:converters="clr-namespace:Plated.Core.Converters;assembly=Plated.Core"
             x:Class="Plated.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
            <converters:InitialConverter x:Key="InitialConverter" />
            <converters:StringIsEmptyConverter x:Key="StringIsEmptyConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
