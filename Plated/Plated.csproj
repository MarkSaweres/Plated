<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- iOS can only be built on macOS; on Windows build Android only -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-android;net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Plated</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Plated</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.plated.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Workaround for XA0129 Fast Deployment failure in Debug -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and $(TargetFramework.Contains('-android'))">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1B33" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="160,160" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.80" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

		<!-- MVVM + community controls -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />

		<!-- Firebase (Auth, Firestore, Storage). Google Sign-In is implemented natively per
		     platform (see Platforms/*/GoogleSignInService.cs) rather than via
		     Plugin.Firebase.Auth.Google, which never moved past 3.1.2 and depends on
		     Plugin.Firebase.Core 3.x types removed in 4.x. -->
		<PackageReference Include="Plugin.Firebase.Core" Version="4.2.0" />
		<PackageReference Include="Plugin.Firebase.Auth" Version="5.0.1" />
		<PackageReference Include="Plugin.Firebase.Firestore" Version="4.0.0" />
		<PackageReference Include="Plugin.Firebase.Storage" Version="4.0.0" />

		<!-- On-device OCR for reading plates from photos -->
		<PackageReference Include="Plugin.Maui.OCR" Version="1.1.1" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Google Sign-In via Credential Manager (replaces the deprecated One Tap API) -->
		<PackageReference Include="Xamarin.AndroidX.Credentials" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.6.0.2" />
		<PackageReference Include="Xamarin.Google.Android.Libraries.Identity.GoogleId" Version="1.1.0.16" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="Xamarin.Google.iOS.SignIn" Version="5.0.2.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plated.Core\Plated.Core.csproj" />
	</ItemGroup>

	<!-- Firebase platform config. Add your own google-services.json / GoogleService-Info.plist here (see README) -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND Exists('Platforms\Android\google-services.json')">
		<GoogleServicesJson Include="Platforms\Android\google-services.json" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' AND Exists('Platforms\iOS\GoogleService-Info.plist')">
		<GoogleServiceInfoPlist Include="Platforms\iOS\GoogleService-Info.plist" />
	</ItemGroup>

</Project>
