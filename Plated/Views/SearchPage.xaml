<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Plated.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Plated.Core.ViewModels;assembly=Plated.Core"
    x:DataType="vm:SearchViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32" Spacing="22">

            <Label Text="PLATED"
                   Style="{StaticResource FieldLabel}"
                   FontSize="13"
                   CharacterSpacing="4" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Look up a plate" Style="{StaticResource ScreenTitle}" />
                <Label Text="Read what people have said about a car, or be the first to leave a note."
                       Style="{StaticResource Subtle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource PlateBorder}" Padding="20,10,20,18">
                <VerticalStackLayout Spacing="0">
                    <Picker ItemsSource="{Binding States}"
                            SelectedItem="{Binding SelectedState}"
                            FontFamily="CaveatBold"
                            FontSize="30"
                            TextColor="{StaticResource PlateRed}"
                            HorizontalTextAlignment="Center" />
                    <Entry Text="{Binding PlateNumber}"
                           Placeholder="8ABC123"
                           PlaceholderColor="{StaticResource Gray300}"
                           TextTransform="Uppercase"
                           FontFamily="OpenSansSemibold"
                           FontSize="36"
                           CharacterSpacing="4"
                           TextColor="{StaticResource OffBlack}"
                           HorizontalTextAlignment="Center"
                           ReturnType="Search"
                           ReturnCommand="{Binding SearchCommand}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Search plate"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE8B6;" Size="20" Color="{StaticResource White}" />
                </Button.ImageSource>
            </Button>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource PlateRed}"
                   FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
