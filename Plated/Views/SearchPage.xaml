<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Plated.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Plated.Controls"
    xmlns:models="clr-namespace:Plated.Core.Services;assembly=Plated.Core"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Plated.Core.ViewModels;assembly=Plated.Core"
    x:DataType="vm:SearchViewModel"
    BackgroundColor="{StaticResource PageBg}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Gradient header -->
                <Border Background="{StaticResource HeroBrush}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0,0,32,32"
                        Padding="24,24,24,100">
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Spacing="10">
                            <shapes:Path Data="M0,10 C8,2 16,2 24,10 C32,18 40,18 48,10 C56,2 64,2 72,10 C80,18 88,18 96,10"
                                         Stroke="{StaticResource PlateRed}"
                                         StrokeThickness="5"
                                         StrokeLineCap="Round"
                                         WidthRequest="30"
                                         HeightRequest="14"
                                         Aspect="Fill"
                                         VerticalOptions="Center" />
                            <Label Text="PLATED"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   CharacterSpacing="5"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="Who's behind&#10;that plate?"
                               FontFamily="OpenSansSemibold"
                               FontSize="32"
                               LineHeight="1.1"
                               TextColor="White"
                               Margin="0,28,0,0" />
                        <Label Text="See what people are saying, or leave a note of your own."
                               FontSize="14"
                               TextColor="#C7D2E8"
                               Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- The plate: state + number -->
                <Border x:Name="PlateCard"
                        Style="{StaticResource PlateBorder}"
                        Margin="20,-80,20,0"
                        Padding="18,10,18,16">
                    <Border.Shadow>
                        <Shadow Brush="#0B1B33" Opacity="0.28" Radius="24" Offset="0,12" />
                    </Border.Shadow>
                    <Grid>
                        <Border WidthRequest="8" HeightRequest="8" Padding="0" StrokeThickness="0"
                                StrokeShape="RoundRectangle 4" BackgroundColor="#CBD5E1"
                                HorizontalOptions="Start" VerticalOptions="Start" Margin="-6,-2,0,0" />
                        <Border WidthRequest="8" HeightRequest="8" Padding="0" StrokeThickness="0"
                                StrokeShape="RoundRectangle 4" BackgroundColor="#CBD5E1"
                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,-2,-6,0" />
                        <VerticalStackLayout Spacing="0">
                            <Picker ItemsSource="{Binding StateNames}"
                                    SelectedItem="{Binding SelectedStateName}"
                                    FontFamily="CaveatBold"
                                    FontSize="36"
                                    TextColor="{StaticResource PlateRed}"
                                    HorizontalTextAlignment="Center" />
                            <Entry Text="{Binding PlateNumber}"
                                   Placeholder="7ABC123"
                                   PlaceholderColor="{StaticResource Gray300}"
                                   TextTransform="Uppercase"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="42"
                                   CharacterSpacing="6"
                                   TextColor="{StaticResource OffBlack}"
                                   HorizontalTextAlignment="Center"
                                   ReturnType="Search"
                                   ReturnCommand="{Binding SearchCommand}" />
                            <shapes:Path Data="M0,10 C8,2 16,2 24,10 C32,18 40,18 48,10 C56,2 64,2 72,10 C80,18 88,18 96,10"
                                         Stroke="{StaticResource PlateBlueBrush}"
                                         StrokeThickness="4"
                                         StrokeLineCap="Round"
                                         HeightRequest="20"
                                         WidthRequest="96"
                                         HorizontalOptions="Center"
                                         Margin="0,2,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Padding="20,20,20,0" Spacing="12">
                    <Button Text="Search plate"
                            Command="{Binding SearchCommand}"
                            FontSize="17"
                            MinimumHeightRequest="58"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE8B6;" Size="22" Color="{StaticResource White}" />
                        </Button.ImageSource>
                    </Button>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Scan with camera"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ScanWithCameraCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE412;" Size="22" Color="{StaticResource Primary}" />
                            </Button.ImageSource>
                        </Button>
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ScanFromGalleryCommand}"
                                WidthRequest="56"
                                Padding="0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                AutomationProperties.Name="Scan a photo from your gallery">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE3B6;" Size="22" Color="{StaticResource Primary}" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsScanning}">
                        <ActivityIndicator IsRunning="{Binding IsScanning}" Color="{StaticResource PlateRed}" />
                        <Label Text="Reading the plate..." Style="{StaticResource Subtle}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource PlateRed}" />

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource PlateRed}"
                           FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>

                <!-- Recently looked up -->
                <VerticalStackLayout Padding="0,18,0,24" Spacing="12" IsVisible="{Binding HasRecent}">
                    <Label Text="RECENTLY LOOKED UP"
                           Style="{StaticResource FieldLabel}"
                           CharacterSpacing="2"
                           Margin="20,0,0,0" />
                    <CollectionView ItemsSource="{Binding RecentPlates}"
                                    HeightRequest="98"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Header>
                            <BoxView WidthRequest="8" HeightRequest="1" BackgroundColor="Transparent" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecentPlate">
                                <Border Style="{StaticResource PlateBorder}"
                                        StrokeThickness="2"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="14,8,14,10"
                                        WidthRequest="132"
                                        VerticalOptions="Start">
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                        <Label Text="{Binding StateName}"
                                               FontFamily="CaveatBold"
                                               FontSize="20"
                                               TextColor="{StaticResource PlateRed}"
                                               LineBreakMode="TailTruncation"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding Number}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="20"
                                               CharacterSpacing="2"
                                               TextColor="{StaticResource OffBlack}"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenRecentCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:AdBanner Grid.Row="1" Margin="0,0,0,6" />
    </Grid>
</ContentPage>
