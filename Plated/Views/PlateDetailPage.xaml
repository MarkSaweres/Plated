<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Plated.Views.PlateDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Plated.Core.ViewModels;assembly=Plated.Core"
    xmlns:models="clr-namespace:Plated.Core.Models;assembly=Plated.Core"
    x:DataType="vm:PlateDetailViewModel"
    Title="Plate">

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="24,8,24,16" Spacing="10">
            <Border Style="{StaticResource PlateBorder}" HorizontalOptions="Center" Padding="36,10,36,14">
                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                    <Label Text="{Binding State}"
                           FontFamily="CaveatBold"
                           FontSize="28"
                           TextColor="{StaticResource PlateRed}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding PlateNumber}"
                           FontFamily="OpenSansSemibold"
                           FontSize="38"
                           CharacterSpacing="4"
                           TextColor="{StaticResource OffBlack}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding CommentCount, StringFormat='{0} comments'}"
                   Style="{StaticResource Subtle}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Comments}" Margin="20,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="6" Padding="0,40,0,0">
                        <Label Style="{StaticResource IconGlyph}" Text="&#xE0CB;" FontSize="44" HorizontalOptions="Center" TextColor="{StaticResource Gray300}" />
                        <Label Text="No comments yet" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Ink}" HorizontalOptions="Center" />
                        <Label Text="Be the first to leave one below." Style="{StaticResource Subtle}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlateComment">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Padding="0"
                                            Stroke="Transparent"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource AccentSoft}">
                                        <Label Text="{Binding AuthorDisplayName, Converter={StaticResource InitialConverter}}"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Accent}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Label Text="{Binding AuthorDisplayName}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               TextColor="{StaticResource Ink}" />
                                        <Label Text="{Binding CreatedAt, Converter={StaticResource RelativeTimeConverter}}"
                                               Style="{StaticResource Subtle}"
                                               FontSize="12" />
                                    </VerticalStackLayout>
                                    <ImageButton Grid.Column="2"
                                                 WidthRequest="40"
                                                 HeightRequest="40"
                                                 Padding="9"
                                                 BackgroundColor="Transparent"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReportCommentCommand}"
                                                 CommandParameter="{Binding .}">
                                        <ImageButton.Source>
                                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE153;" Size="20" Color="{StaticResource Gray400}" />
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                                <Label Text="{Binding Text}" FontSize="16" TextColor="{StaticResource Ink}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="2" BackgroundColor="{StaticResource White}" Spacing="0">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
            <VerticalStackLayout Padding="16,12,16,14" Spacing="10">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource PlateRed}"
                       FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 24">
                        <Entry Text="{Binding NewCommentText}" Placeholder="Add a comment..." />
                    </Border>
                    <ImageButton Grid.Column="1"
                                 Command="{Binding AddCommentCommand}"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                 BackgroundColor="{StaticResource Primary}"
                                 WidthRequest="48"
                                 HeightRequest="48"
                                 Padding="12"
                                 CornerRadius="24"
                                 VerticalOptions="Center">
                        <ImageButton.Source>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE163;" Size="22" Color="{StaticResource White}" />
                        </ImageButton.Source>
                    </ImageButton>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Dim backdrop -->
        <BoxView Grid.RowSpan="3"
                 Color="Black"
                 Opacity="0.45"
                 IsVisible="{Binding IsSheetVisible}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSheetsCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Report sheet -->
        <Border Grid.RowSpan="3"
                VerticalOptions="End"
                BackgroundColor="{StaticResource White}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28,28,0,0"
                Padding="20,12,20,24"
                IsVisible="{Binding IsReportSheetOpen}">
            <VerticalStackLayout Spacing="4">
                <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" Color="{StaticResource Gray300}" HorizontalOptions="Center" Margin="0,0,0,12" />

                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsReportSent, Converter={StaticResource InverseBooleanConverter}}">
                    <Label Text="Report this comment" FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource Ink}" />
                    <Label Text="Why are you reporting it? Comments reported by several people are hidden automatically."
                           Style="{StaticResource Subtle}" FontSize="13" Margin="0,0,0,8" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="4,10">
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Field}">
                                    <Label Style="{StaticResource IconGlyph}" Text="&#xE160;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="Spam" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" />
                                    <Label Text="Ads, links, or repeated posts" Style="{StaticResource Subtle}" FontSize="13" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource IconGlyph}" Text="&#xE5CC;" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SubmitReportCommand}" CommandParameter="spam" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="4,10">
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Field}">
                                    <Label Style="{StaticResource IconGlyph}" Text="&#xE002;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="Harassment" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" />
                                    <Label Text="Abusive, hateful, or threatening" Style="{StaticResource Subtle}" FontSize="13" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource IconGlyph}" Text="&#xE5CC;" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SubmitReportCommand}" CommandParameter="harassment" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="4,10">
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Field}">
                                    <Label Style="{StaticResource IconGlyph}" Text="&#xE88E;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="Inaccurate" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" />
                                    <Label Text="Wrong plate or false information" Style="{StaticResource Subtle}" FontSize="13" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource IconGlyph}" Text="&#xE5CC;" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SubmitReportCommand}" CommandParameter="inaccurate" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="4,10">
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Field}">
                                    <Label Style="{StaticResource IconGlyph}" Text="&#xE5D3;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="Something else" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" />
                                    <Label Text="Anything that doesn't belong here" Style="{StaticResource Subtle}" FontSize="13" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource IconGlyph}" Text="&#xE5CC;" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SubmitReportCommand}" CommandParameter="other" />
                                </Grid.GestureRecognizers>
                            </Grid>
                    <Label Text="{Binding ReportError}"
                           TextColor="{StaticResource PlateRed}"
                           FontSize="13"
                           IsVisible="{Binding ReportError, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CloseSheetsCommand}" Margin="0,8,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" Padding="0,8,0,0" IsVisible="{Binding IsReportSent}">
                    <Border WidthRequest="64" HeightRequest="64" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 32" BackgroundColor="{StaticResource AccentSoft}" HorizontalOptions="Center">
                        <Label Style="{StaticResource IconGlyph}" Text="&#xE86C;" FontSize="34" TextColor="{StaticResource Accent}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Thanks for letting us know" FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource Ink}" HorizontalOptions="Center" />
                    <Label Text="We'll take a look. Reports help keep Plated respectful."
                           Style="{StaticResource Subtle}" HorizontalTextAlignment="Center" Margin="0,0,0,8" />
                    <Button Text="Done" Command="{Binding CloseSheetsCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
