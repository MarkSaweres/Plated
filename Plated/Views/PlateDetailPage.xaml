<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Plated.Views.PlateDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Plated.Core.ViewModels;assembly=Plated.Core"
    xmlns:models="clr-namespace:Plated.Core.Models;assembly=Plated.Core"
    x:DataType="vm:PlateDetailViewModel"
    Title="Plate">

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="24,20,24,12" Spacing="4"
                              BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray950}}">
            <Label FontFamily="OpenSansSemibold" FontSize="26" TextColor="{StaticResource OffBlack}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding State}" />
                        <Span Text=" · " />
                        <Span Text="{Binding PlateNumber}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Text="{Binding CommentCount, StringFormat='{0} comments'}"
                   TextColor="{StaticResource Gray500}"
                   FontSize="14" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Comments}"
                             Margin="24,12">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8" Padding="0,60,0,0">
                        <Label Text="No comments yet" FontFamily="OpenSansSemibold" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Be the first to leave one below." TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlateComment">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{Binding AuthorDisplayName}" FontFamily="OpenSansSemibold" FontSize="15" />
                                        <Label Text="{Binding CreatedAt, Converter={StaticResource RelativeTimeConverter}}"
                                               FontSize="12" TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="Report"
                                            FontSize="12"
                                            Padding="10,4"
                                            HeightRequest="30"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Gray500}"
                                            BorderColor="{StaticResource Gray300}"
                                            BorderWidth="1"
                                            CornerRadius="15"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReportCommentCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                                <Label Text="{Binding Text}" TextColor="{StaticResource OffBlack}" />
                                <Image Source="{Binding PhotoUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="160"
                                       IsVisible="{Binding PhotoUrl, Converter={StaticResource StringNotEmptyConverter}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="2" Padding="16" Spacing="10"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
            <Border Style="{StaticResource CardBorder}"
                    Padding="8"
                    HeightRequest="90"
                    IsVisible="{Binding PendingPhotoPath, Converter={StaticResource StringNotEmptyConverter}}">
                <Image Source="{Binding PendingPhotoPath}" Aspect="AspectFit" />
            </Border>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ImageButton Grid.Column="0"
                             Command="{Binding AttachPhotoCommand}"
                             BackgroundColor="{StaticResource Gray100}"
                             WidthRequest="44"
                             HeightRequest="44"
                             CornerRadius="22">
                    <ImageButton.Source>
                        <FontImageSource Glyph="&#128247;" Color="{StaticResource OffBlack}" Size="18" />
                    </ImageButton.Source>
                </ImageButton>
                <Entry Grid.Column="1"
                       Text="{Binding NewCommentText}"
                       Placeholder="Add a comment..."
                       VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text="Post"
                        Command="{Binding AddCommentCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        CornerRadius="20"
                        HeightRequest="40"
                        Padding="16,0" />
            </Grid>
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource PlateRed}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
