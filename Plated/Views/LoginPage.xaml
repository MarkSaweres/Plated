<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Plated.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Plated.Core.ViewModels;assembly=Plated.Core"
    x:DataType="vm:LoginViewModel"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border Background="{StaticResource HeroBrush}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 0,0,32,32"
                    Padding="24,32,24,100">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Who's behind&#10;that plate?"
                           FontFamily="OpenSansSemibold"
                           FontSize="32"
                           LineHeight="1.1"
                           TextColor="White" />
                    <Label Text="See what people are saying about a license plate, or leave a note of your own."
                           FontSize="14"
                           TextColor="#C7D2E8" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource PlateBorder}"
                    HorizontalOptions="Center"
                    Margin="0,-70,0,0"
                    Padding="34,12,34,16">
                <Border.Shadow>
                    <Shadow Brush="#0B1B33" Opacity="0.28" Radius="24" Offset="0,12" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                    <Label Text="California"
                           FontFamily="CaveatBold"
                           FontSize="36"
                           TextColor="{StaticResource PlateRed}"
                           HorizontalOptions="Center" />
                    <Label Text="PLATED"
                           FontFamily="OpenSansSemibold"
                           FontSize="46"
                           CharacterSpacing="2"
                           TextColor="{StaticResource OffBlack}"
                           HorizontalOptions="Center" />
                    <shapes:Path Data="M0,10 C8,2 16,2 24,10 C32,18 40,18 48,10 C56,2 64,2 72,10 C80,18 88,18 96,10"
                                 Stroke="{StaticResource PlateBlueBrush}"
                                 StrokeThickness="4"
                                 StrokeLineCap="Round"
                                 HeightRequest="20"
                                 WidthRequest="96"
                                 HorizontalOptions="Center"
                                 Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="24,24,24,32" Spacing="22">

            <Border Style="{StaticResource CardBorder}" Padding="18">
                <VerticalStackLayout Spacing="12">

                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource IconGlyph}" Text="&#xE158;" />
                            <Entry Grid.Column="1"
                                   Text="{Binding Email}"
                                   Placeholder="Email"
                                   Keyboard="Email" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource IconGlyph}" Text="&#xE897;" />
                            <Entry Grid.Column="1"
                                   Text="{Binding Password}"
                                   Placeholder="Password (6+ characters)"
                                   IsPassword="True" />
                        </Grid>
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource PlateRed}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primary}" />

                    <Button Text="Sign In"
                            Command="{Binding SignInWithEmailCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />

                    <Button Text="Create Account"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding GoToCreateAccountCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                <BoxView Grid.Column="0" HeightRequest="1" VerticalOptions="Center" BackgroundColor="{StaticResource Line}" />
                <Label Grid.Column="1" Text="or" Style="{StaticResource Subtle}" FontSize="13" />
                <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center" BackgroundColor="{StaticResource Line}" />
            </Grid>

            <Button Text="Continue with Google"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding SignInWithGoogleCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
