<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Plated.Views.AddEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Plated.Core.ViewModels;assembly=Plated.Core"
    x:DataType="vm:AddEntryViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32" Spacing="20">

            <VerticalStackLayout Spacing="6">
                <Label Text="Add an entry" Style="{StaticResource ScreenTitle}" />
                <Label Text="Snap or upload a photo and we'll try to read the plate for you."
                       Style="{StaticResource Subtle}" />
            </VerticalStackLayout>

            <Grid>
                <Border Style="{StaticResource FieldBorder}"
                        HeightRequest="170"
                        Padding="0"
                        IsVisible="{Binding PhotoPath, Converter={StaticResource StringIsEmptyConverter}}">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                        <Label Style="{StaticResource IconGlyph}" Text="&#xE439;" FontSize="42" HorizontalOptions="Center" />
                        <Label Text="Add a photo of the plate"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource Ink}"
                               HorizontalOptions="Center" />
                        <Label Text="Plate numbers are read on your phone"
                               Style="{StaticResource Subtle}"
                               FontSize="13"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource FieldBorder}"
                        HeightRequest="220"
                        Padding="0"
                        IsVisible="{Binding PhotoPath, Converter={StaticResource StringNotEmptyConverter}}">
                    <Image Source="{Binding PhotoPath}" Aspect="AspectFill" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Camera"
                        Command="{Binding TakePhotoCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE412;" Size="20" Color="{StaticResource White}" />
                    </Button.ImageSource>
                </Button>
                <Button Grid.Column="1"
                        Text="Gallery"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding PickPhotoCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE413;" Size="20" Color="{StaticResource Ink}" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsScanning}">
                <ActivityIndicator IsRunning="{Binding IsScanning}" Color="{StaticResource Accent}" />
                <Label Text="Reading the plate..." Style="{StaticResource Subtle}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding ScanMessage}"
                   Style="{StaticResource Subtle}"
                   TextColor="{StaticResource Accent}"
                   IsVisible="{Binding ScanMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Border Style="{StaticResource CardBorder}" Padding="18">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="STATE" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Picker ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="PLATE NUMBER" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding PlateNumber}"
                                   Placeholder="8ABC123"
                                   TextTransform="Uppercase"
                                   FontFamily="OpenSansSemibold"
                                   CharacterSpacing="2" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="YOUR COMMENT" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}" Padding="14,6">
                            <Editor Text="{Binding CommentText}"
                                    Placeholder="What do you want to say about this plate?"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="96" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource PlateRed}"
                   FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Button Text="Post"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
