<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Plated.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Plated.Core.ViewModels;assembly=Plated.Core"
    x:DataType="vm:ProfileViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32" Spacing="22">

            <Label Text="Profile" Style="{StaticResource ScreenTitle}" />

            <Border Style="{StaticResource CardBorder}" Padding="24">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border WidthRequest="88"
                            HeightRequest="88"
                            Padding="0"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 44"
                            BackgroundColor="{StaticResource AccentSoft}"
                            HorizontalOptions="Center">
                        <Grid>
                            <Label Text="{Binding CurrentUser.DisplayName, Converter={StaticResource InitialConverter}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="34"
                                   TextColor="{StaticResource Accent}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Image Source="{Binding CurrentUser.PhotoUrl}" Aspect="AspectFill" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding CurrentUser.DisplayName}"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               TextColor="{StaticResource Ink}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentUser.Email}"
                               Style="{StaticResource Subtle}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource PlateRed}"
                   FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Button Text="Sign Out"
                    Style="{StaticResource SecondaryButton}"
                    TextColor="{StaticResource PlateRed}"
                    Command="{Binding SignOutCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE9BA;" Size="20" Color="{StaticResource PlateRed}" />
                </Button.ImageSource>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
