<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Plated.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Plated.Controls"
    xmlns:vm="clr-namespace:Plated.Core.ViewModels;assembly=Plated.Core"
    x:DataType="vm:ProfileViewModel"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border Background="{StaticResource HeroBrush}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 0,0,32,32"
                    Padding="24,24,24,32">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border WidthRequest="96"
                            HeightRequest="96"
                            Padding="0"
                            Stroke="White"
                            StrokeThickness="3"
                            StrokeShape="RoundRectangle 48"
                            BackgroundColor="{StaticResource PlateBlue}"
                            HorizontalOptions="Center">
                        <Grid>
                            <Label Text="{Binding CurrentUser.DisplayName, Converter={StaticResource InitialConverter}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="38"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Image Source="{Binding CurrentUser.PhotoUrl}" Aspect="AspectFill" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding CurrentUser.DisplayName}"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentUser.Email}"
                               FontSize="14"
                               TextColor="#C7D2E8"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="24,22,24,32" Spacing="22">

            <!-- Upgrade card: shown while ads are on -->
            <Border Style="{StaticResource CardBorder}" Padding="20" IsVisible="{Binding AdsState.ShowAds}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" Padding="0" StrokeThickness="0"
                                StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource AccentSoft}">
                            <Label Style="{StaticResource IconGlyph}" Text="&#xE8E8;" FontSize="22"
                                   TextColor="{StaticResource Accent}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Go ad-free" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Ink}" />
                            <Label Text="One payment, no subscription. Yours on every device signed in to your store account."
                                   Style="{StaticResource Subtle}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="Remove ads"
                            Command="{Binding RemoveAdsCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    <Label Text="{Binding RemoveAdsPrice, StringFormat='One-time purchase: {0}'}"
                           Style="{StaticResource Subtle}" FontSize="12" HorizontalOptions="Center"
                           IsVisible="{Binding RemoveAdsPrice, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Button Text="Restore purchase"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RestorePurchasesCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Thank-you card: shown once ads are removed -->
            <Border Style="{StaticResource CardBorder}" Padding="20" IsVisible="{Binding AdsState.AdsRemoved}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Label Grid.Column="0" Style="{StaticResource IconGlyph}" Text="&#xE86C;" FontSize="28"
                           TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Ads removed" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Ink}" />
                        <Label Text="Thanks for supporting Plated." Style="{StaticResource Subtle}" FontSize="13" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="{Binding PurchaseMessage}"
                   Style="{StaticResource Subtle}"
                   TextColor="{StaticResource Accent}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding PurchaseMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource PlateRed}"
                   FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Button Text="Sign Out"
                    Style="{StaticResource SecondaryButton}"
                    TextColor="{StaticResource PlateRed}"
                    Command="{Binding SignOutCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE9BA;" Size="20" Color="{StaticResource PlateRed}" />
                </Button.ImageSource>
            </Button>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    <controls:AdBanner Grid.Row="1" Margin="0,0,0,6" />
    </Grid>
</ContentPage>
