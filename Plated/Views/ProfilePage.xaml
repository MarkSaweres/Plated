<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Plated.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Plated.Core.ViewModels;assembly=Plated.Core"
    x:DataType="vm:ProfileViewModel"
    Title="Profile">

    <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Start">

        <Border Style="{StaticResource CardBorder}" HorizontalOptions="Center" Padding="24">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Border StrokeShape="RoundRectangle 40"
                        HeightRequest="80"
                        WidthRequest="80"
                        Stroke="{StaticResource Gray300}"
                        StrokeThickness="1"
                        Padding="0">
                    <Image Source="{Binding CurrentUser.PhotoUrl}" Aspect="AspectFill" />
                </Border>
                <Label Text="{Binding CurrentUser.DisplayName}"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"
                       HorizontalOptions="Center" />
                <Label Text="{Binding CurrentUser.Email}"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <Button Text="Sign Out"
                Command="{Binding SignOutCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                BackgroundColor="{StaticResource White}"
                TextColor="{StaticResource PlateRed}"
                BorderColor="{StaticResource Gray300}"
                BorderWidth="1"
                CornerRadius="24"
                HeightRequest="50" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource Primary}" />

        <Label Text="{Binding ErrorMessage}"
               TextColor="{StaticResource PlateRed}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

    </VerticalStackLayout>
</ContentPage>
